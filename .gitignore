# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but example templates are shipped, not secrets
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI temp
supabase/.temp

# Local Claude session state — not part of the project
.claude/*
# ...but the skills bundle is part of the project: it teaches an
# adopting team's AI how to change this codebase safely. Local session
# state above it stays ignored.
!.claude/skills/

# Generator scratch output — regenerate it, do not commit it.
regulatory-packs/emit-warnings.txt

# Tracker exports are the private source a pack is built FROM, the same
# way factor-packs does not commit a publisher's spreadsheet. The mapping
# and the generated migration are what ship.
*-Regulatory-Tracker.html

# Company-specific scrubbing rules for regulatory packs. A rule has to name
# the company in order to remove it, so committing one defeats the scrub.
regulatory-packs/**/scrub.local.json

# Claude Code local session state. The skills under .claude/skills/ are part of
# the project and are tracked; this file is per-machine permission state.
.claude/settings.local.json
