# ─────────────────────────────────────────────────────────────────────────────
# BROC deployment configuration
#
# Copy to .env and fill in. Run ./preflight.sh afterwards — it reads the source
# and tells you whether this file covers every variable the code actually uses,
# rather than making you trust this template.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase connection ──────────────────────────────────────────────────────
# Supabase Cloud:  Project Settings → API
# Self-hosted:     http://<host>:8000  (the API gateway, not the Studio port)
#
# These two are compiled into the browser bundle. Changing them means
# rebuilding the image, not just restarting the container.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security, so it must never appear in a
# NEXT_PUBLIC_ variable, a client component, or a browser-visible log.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (migrations only) ───────────────────────────────────────────────
# Used by migrate.sh. Not read by the application at run time.
# Supabase Cloud: Project Settings → Database → Connection string → URI
DATABASE_URL=

# ── Outbound email (optional) ────────────────────────────────────────────────
# Supplier survey invitations are sent by the send-survey-email Supabase Edge
# Function, not by this container, so its settings live in Supabase:
#   supabase secrets set RESEND_API_KEY=... RESEND_FROM_EMAIL=... APP_URL=...
# Without them BROC shows the invitation text for manual sending.

# ── Optional AI layer ────────────────────────────────────────────────────────
# Bring your own model. Leave AI_PROVIDER blank and every feature still works —
# the regulatory watch just will not propose updates, and disclosure drafting
# is hidden. Leave it blank for an air-gapped install. lib/ai/config.ts reads:
#
#   AI_PROVIDER   anthropic | openai | openai-compatible
#   AI_API_KEY    the provider key (optional for a local openai-compatible runtime)
#   AI_MODEL      the model id; required for openai-compatible
#   AI_BASE_URL   only for openai-compatible (Ollama, vLLM, LM Studio, a gateway)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ── Sign-up ──────────────────────────────────────────────────────────────────
# The first person to sign up creates the organization and becomes its admin;
# after that /signup is closed and colleagues join by invitation (Settings →
# Team). Set to true only for a deployment that is meant to host several
# unrelated organizations — every one of their admins can edit the shared
# disclosure-requirement and regulatory reference data. See SECURITY.md.
ALLOW_PUBLIC_SIGNUP=false

# ── Build-time options (optional) ────────────────────────────────────────────
# Inlined into the app when the image is BUILT, so changing one needs
# `docker compose up -d --build`. Blank means "use the built-in default".
#
# Public URL of this deployment, used in invitation links. When blank, the
# address the admin is using when they send the invite is used.
NEXT_PUBLIC_APP_URL=
#
# White-label branding — see lib/branding.ts for what each one changes.
NEXT_PUBLIC_PRODUCT_NAME=
NEXT_PUBLIC_PRODUCT_SHORT_NAME=
NEXT_PUBLIC_PRODUCT_TAGLINE=
NEXT_PUBLIC_PRODUCT_MARK=
NEXT_PUBLIC_PRODUCT_MARK_SRC=
NEXT_PUBLIC_PRODUCT_WORDMARK_SRC=
#
# Which single sign-on buttons the login page offers (e.g. azure,google), and
# whether to offer SAML. The providers themselves are configured in Supabase
# Auth — see docs/SSO.md.
NEXT_PUBLIC_SSO_PROVIDERS=
NEXT_PUBLIC_SSO_SAML=

# ── Host ─────────────────────────────────────────────────────────────────────
BROC_PORT=3000
