# ─────────────────────────────────────────────────────────────────────────────
# BROC — local development configuration
#
#   cp .env.example .env.local      # then fill in the three Supabase values
#
# Only the Supabase block is required. Everything else is optional and the app
# runs without it. For a Docker deployment use deploy/.env.example instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row-level security entirely — never give it a
# NEXT_PUBLIC_ prefix, never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sign-up ──────────────────────────────────────────────────────────────────
# The first sign-up creates the organization and becomes its admin; after that
# /signup is closed and colleagues join by invitation (Settings → Team). Set to
# true only for a deployment meant to host several unrelated organizations.
# See SECURITY.md before you do.
ALLOW_PUBLIC_SIGNUP=false

# Public URL of this deployment, used in invitation links. Optional: when blank
# the address the admin is using when they send the invite is used.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Branding (optional) ──────────────────────────────────────────────────────
# White-label without forking. See lib/branding.ts for what each one changes.
# NEXT_PUBLIC_PRODUCT_NAME=
# NEXT_PUBLIC_PRODUCT_SHORT_NAME=
# NEXT_PUBLIC_PRODUCT_TAGLINE=
# NEXT_PUBLIC_PRODUCT_MARK=
# NEXT_PUBLIC_PRODUCT_MARK_SRC=
# NEXT_PUBLIC_PRODUCT_WORDMARK_SRC=

# ── Single sign-on (optional) ────────────────────────────────────────────────
# Which buttons the login page offers. The providers themselves are configured
# in Supabase Auth; see docs/SSO.md.
# NEXT_PUBLIC_SSO_PROVIDERS=azure,google
# NEXT_PUBLIC_SSO_SAML=true

# ── Optional AI layer ────────────────────────────────────────────────────────
# Off unless AI_PROVIDER is set. Provider-agnostic; see lib/ai/config.ts.
#   AI_PROVIDER   anthropic | openai | openai-compatible
#   AI_API_KEY    provider key (optional for a local openai-compatible runtime)
#   AI_MODEL      model id; required for openai-compatible
#   AI_BASE_URL   only for openai-compatible
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# ── Supplier survey email ────────────────────────────────────────────────────
# Not read by the Next.js app. The send-survey-email Edge Function reads
# RESEND_API_KEY, RESEND_FROM_EMAIL and APP_URL from the Supabase function
# environment (supabase secrets set ...). Without them BROC shows the
# invitation text for manual sending instead.
